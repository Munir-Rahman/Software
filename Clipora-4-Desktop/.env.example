# Windows local use: copy to .env, keep HOST=127.0.0.1 for development.
HOST=127.0.0.1
PORT=3001
# Access authentication is optional for localhost ONLY.
# For a remotely accessible server, use a strong password (12+ chars) and random 32+ char secret.
# ACCESS_PASSWORD=replace-with-very-long-unique-passphrase
# SESSION_SECRET=replace-with-32-plus-random-characters
# Override only if using separately installed binaries.
# YTDLP_PATH=D:\\Tools\\yt-dlp.exe
# FFMPEG_LOCATION=D:\\Tools
MAX_DOWNLOAD_MB=2048
MAX_TOTAL_MB=10240
MAX_CONCURRENT=2
MAX_QUEUED=30
MAX_PLAYLIST_ITEMS=25
MAX_INSPECTS=3
MAX_DURATION_SECONDS=7200
INSPECT_TIMEOUT_MS=60000
JOB_TIMEOUT_MINUTES=45
FILE_TTL_HOURS=720
TRUST_PROXY=0
# DOWNLOAD_DIR=D:\\CliporaDownloads
