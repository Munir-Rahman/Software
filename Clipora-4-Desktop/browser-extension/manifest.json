{
  "manifest_version": 3,
  "name": "Clipora \u2014 One Click Media Downloader",
  "version": "4.1.0",
  "description": "Choose video/audio and quality from YouTube thumbnails, or download direct media using the local Clipora engine.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:3001/*"
  ],
  "action": {
    "default_title": "Clipora \u2014 download media",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://clipora-4-desktop.vercel.app/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
