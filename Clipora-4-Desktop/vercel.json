{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/hosted.py": {
      "maxDuration": 240,
      "excludeFiles": "{browser-extension/**,tests/**,server/**,client/**,public/**,scripts/**}"
    }
  }
}
